# Healthcare QA Chatbot - Environment Variables
# Copy to .env and fill in values

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production | testing
LOG_LEVEL=INFO

# ── GPU ──────────────────────────────────────────────────────────────────────
# Set to true only on a machine with CUDA GPU; false for CPU-only (default)
USE_GPU=false

# ── HuggingFace ──────────────────────────────────────────────────────────────
HUGGINGFACE_TOKEN=               # HF token for gated model downloads
HF_HOME=~/.cache/huggingface    # local HF model cache directory
HF_HUB_OFFLINE=1                 # 1 = skip hub checks (faster startup)
TRANSFORMERS_OFFLINE=1           # 1 = skip transformers hub checks

# ── API server ───────────────────────────────────────────────────────────────
API_KEY=                         # Optional bearer token; empty = no auth
CORS_ORIGINS=http://localhost:8501  # Comma-separated allowed origins

# ── Pipeline ─────────────────────────────────────────────────────────────────
DEFAULT_PIPELINE=standard        # standard | langchain | langgraph

# ── MCP web search (optional) ─────────────────────────────────────────────────
ENABLE_MCP_SEARCH=false
MCP_SEARCH_CMD=npx
MCP_SEARCH_ARGS=-y @modelcontextprotocol/server-brave-search
