# Healthcare QA Chatbot — Environment Configuration
# Copy this file to .env and fill in the values.
# Usage: docker run --env-file .env healthcare-qa

# ── API Settings ─────────────────────────────────────────────────────────────
API_PORT=8000
# Single read key (legacy):
# API_KEY=your-secret-key-here
# Scoped keys — comma-separated KEY:scope pairs (read or admin):
# API_KEYS=readkey123:read,adminkey456:admin
# Dedicated admin key (used with legacy API_KEY above):
# API_KEY_ADMIN=your-admin-key-here
API_URL=http://localhost:8000

# ── Model Settings ────────────────────────────────────────────────────────────
# Options: extractive (default, no GPU needed), ollama (remote GPU server), tinyllama, biomistral
DEFAULT_MODEL=extractive
# ADAPTER_PATH=models/fine_tuned/medical_adapter
# BIOMISTRAL_MODEL_PATH=models/biomistral/ggml-model-Q4_K_M.gguf
HUGGINGFACE_TOKEN=<your-hf-token>

# ── Ollama Remote Backend ─────────────────────────────────────────────────────
# Set these when using model_choice=ollama (Qwen2.5-7B on a DO GPU droplet).
# OLLAMA_BASE_URL must use a port reachable from HF Spaces (80, 443, or 8080).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Shared bearer token for Ollama endpoint protection (generate with: openssl rand -hex 32)
OLLAMA_API_KEY=

# ── Vector Store — Qdrant Cloud ───────────────────────────────────────────────
# If not set, falls back to local ChromaDB at KB_PERSIST_DIR (requires local KB).
QDRANT_URL=https://<your-cluster>.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-api-key>

# ── Pipeline Selection ────────────────────────────────────────────────────────
# Options: standard (default), langchain, langgraph
DEFAULT_PIPELINE=standard

# ── HuggingFace Cache ─────────────────────────────────────────────────────────
# Where to store downloaded HF models (defaults to .hf_cache/ in project root)
# HF_HOME=/path/to/hf/cache

# ── Hardware ─────────────────────────────────────────────────────────────────
USE_GPU=false

# ── Offline Mode ─────────────────────────────────────────────────────────────
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Optional External APIs ────────────────────────────────────────────────────
# Cohere reranker (src/retrieval/reranker.py) — leave blank to skip
# COHERE_API_KEY=your-cohere-key-here

# NCBI Entrez API key for PubMed MCP server (raises rate limit from 3 to 10 req/s)
# NCBI_API_KEY=your-ncbi-key-here

# ── MCP Search (optional) ─────────────────────────────────────────────────────
ENABLE_MCP_SEARCH=false
# MCP_SEARCH_CMD=npx
# MCP_SEARCH_ARGS=-y @modelcontextprotocol/server-brave-search

# ── Knowledge Base ────────────────────────────────────────────────────────────
# Point to KB v2 (505K docs, RecursiveSentenceChunker). Change to
# "medical_knowledge" / "data/knowledge_base" to use the older v1 KB.
CHROMA_COLLECTION=medical_knowledge_v2
KB_PERSIST_DIR=data/knowledge_base_v2

# ── Startup Performance ───────────────────────────────────────────────────────
# Skip BM25 index build at startup (saves ~2 GB RAM; recommended for KB > 300K docs).
# Retrieval falls back to dense-only, which matches the KB v2 eval baseline.
SKIP_BM25=true
# Skip the full pipeline warmup query at startup (faster boot, colder first query).
# SKIP_STARTUP_WARMUP=false
# Skip NLI hallucination detector pre-load (saves ~500 MB, reduces startup by ~1s).
# SKIP_NLI_WARMUP=false

# ── Confidence Gate ───────────────────────────────────────────────────────────
# Post-generation quality gate threshold. Set to 0.0 (disabled) unless you have
# re-calibrated the Platt scorer — default calibration maps most answers to ~0.024.
MIN_ANSWER_CONFIDENCE=0.0
