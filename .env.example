# Healthcare QA Chatbot — Environment Configuration
# Copy this file to .env and fill in the values.
# Usage: docker run --env-file .env healthcare-qa

# ── API Settings ─────────────────────────────────────────────────────────────
API_PORT=8000
# API_KEY=your-secret-key-here
API_URL=http://localhost:8000

# ── Model Settings ────────────────────────────────────────────────────────────
DEFAULT_MODEL=tinyllama
# ADAPTER_PATH=models/fine_tuned/medical_adapter
# BIOMISTRAL_MODEL_PATH=models/biomistral/ggml-model-Q4_K_M.gguf
# HUGGINGFACE_TOKEN=hf_...

# ── Pipeline Selection ────────────────────────────────────────────────────────
# Options: standard (default), langchain, langgraph
DEFAULT_PIPELINE=standard

# ── HuggingFace Cache ─────────────────────────────────────────────────────────
# Where to store downloaded HF models (defaults to .hf_cache/ in project root)
# HF_HOME=/path/to/hf/cache

# ── Hardware ─────────────────────────────────────────────────────────────────
USE_GPU=false

# ── Offline Mode ─────────────────────────────────────────────────────────────
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Optional External APIs ────────────────────────────────────────────────────
# Cohere reranker (src/retrieval/reranker.py) — leave blank to skip
# COHERE_API_KEY=your-cohere-key-here

# NCBI Entrez API key for PubMed MCP server (raises rate limit from 3 to 10 req/s)
# NCBI_API_KEY=your-ncbi-key-here

# ── MCP Search (optional) ─────────────────────────────────────────────────────
ENABLE_MCP_SEARCH=false
# MCP_SEARCH_CMD=npx
# MCP_SEARCH_ARGS=-y @modelcontextprotocol/server-brave-search
