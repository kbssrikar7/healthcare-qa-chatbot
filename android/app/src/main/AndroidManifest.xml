<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- This app makes no network calls of its own — generation, retrieval,
         and embedding all run on-device. onnxruntime-android bundles
         INTERNET/ACCESS_NETWORK_STATE in its own manifest for optional
         features (e.g. remote model fetch) that we never invoke — we only
         call createSession() on a model bundled as an app asset. Stripped
         explicitly so the shipped app has zero network permission, not just
         zero network usage. See project_paperwork/scratch/mobile_port_notes.md
         ("Play Store Readiness"). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MediQuery">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MediQuery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
